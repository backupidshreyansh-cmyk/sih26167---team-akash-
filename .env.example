# -----------------------------------------------------------------------------
# ORBITAL EYE: Environment Configuration
# -----------------------------------------------------------------------------

# [ONLINE MODE]
# The API key required to authenticate with Google's Gemini Vision models.
# Must be kept secret. Do not expose this to the browser/client-side.
GEMINI_API_KEY="your_gemini_api_key_here"

# The Gemini model to use for reasoning and visual analysis.
# Defaults to gemini-3.1-flash-lite
GEMINI_MODEL="gemini-3.1-flash-lite"

# [OFFLINE MODE]
# The endpoint for the local Ollama instance running Qwen3-VL or similar.
# Defaults to http://localhost:11434 if not provided.
# OLLAMA_BASE_URL="http://localhost:11434"

# The specific model tag to use for local inference.
# Defaults to qwen3-vl:4b-instruct
# OLLAMA_MODEL="qwen3-vl:4b-instruct"

# [TRAINING ADAPTATION]
# Path to the fine-tuned LoRA adapter generated by the training pipeline.
# If this is set, the application will reflect that the adaptation is loaded.
# ADAPTER_PATH="./training/runs/latest/adapter"

# [SERVER CONFIG]
# The port the Express/Vite server will bind to.
# PORT=3000

# The maximum execution time in milliseconds for the AI to complete its multimodal workflows.
# Some cross-modal workflows require multiple sequential inference steps.
# Defaults to 60000 (60 seconds)
# AI_REQUEST_TIMEOUT_MS="60000"
